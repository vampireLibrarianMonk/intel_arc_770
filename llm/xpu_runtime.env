# xpu_runtime.env — runtime vars for IPEX-LLM on the Arc A770.
# Sourced by run_llm_tests.sh. Values from Intel's install guide (Arc A-series).

# IPEX-LLM recommended for Arc A-series
export USE_XETLA=OFF
export SYCL_CACHE_PERSISTENT=1
export SYCL_PI_LEVEL_ZERO_USE_IMMEDIATE_COMMANDLISTS=1

# Our bring-up finding: lift the 4 GiB per-allocation cap so big models/KV-cache fit.
# (Intel debug key; dev-only. See reports/FINDINGS_memory_4gib.md.)
export NEOReadDebugKeys=1
export AllowUnrestrictedSize=1
