# xpu_runtime.env — runtime vars for IPEX-LLM on the Arc A770.
# Sourced by run_llm_tests.sh. Values from Intel's install guide (Arc A-series).

# IPEX-LLM recommended for Arc A-series
export USE_XETLA=OFF
export SYCL_CACHE_PERSISTENT=1
export SYCL_PI_LEVEL_ZERO_USE_IMMEDIATE_COMMANDLISTS=1

# Our bring-up finding: lift the 4 GiB per-allocation cap so big models/KV-cache fit.
# (Intel debug key; dev-only. See reports/FINDINGS_memory_4gib.md.)
export NEOReadDebugKeys=1
export AllowUnrestrictedSize=1

# --- runtime library path (REQUIRED) ---
# The IPEX-LLM XPU kernels (xe_linear / libdnnl.so.3) and torch's own .so files are NOT
# on the default loader path for a plain `pip install` into a venv. Without this you get
# `ImportError: libdnnl.so.3: cannot open shared object file` (or libtorch.so) the moment a
# model actually runs on the GPU. These dirs ship inside the venv; add them explicitly.
# VIRTUAL_ENV is set by `source .venv-llm/bin/activate`, which the run_*.sh scripts do first.
if [ -n "${VIRTUAL_ENV:-}" ]; then
  # site-packages dir, resolved from the venv's actual python (don't hardcode 3.11).
  _sp="$("$VIRTUAL_ENV/bin/python" -c 'import site; print(site.getsitepackages()[0])' 2>/dev/null)"
  if [ -n "$_sp" ]; then
    export LD_LIBRARY_PATH="$_sp:$_sp/torch/lib:$VIRTUAL_ENV/lib:${LD_LIBRARY_PATH:-}"
  fi
  unset _sp
fi

# --- Hugging Face download backend ---
# Disable the Xet transfer backend: on slow/flaky mirrors it stalls mid-download with no
# progress and no error (the blob .incomplete file simply stops growing), which looks like a
# GPU hang but is purely the downloader. The classic HTTP path resumes reliably. If you have
# a fast, Xet-friendly link you can comment this out to use Xet.
export HF_HUB_DISABLE_XET=1
