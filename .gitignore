# Upstream clones and bulky outputs are not tracked
/vendor/
/artifacts/

# Kiro session transcripts / private session data (not project content)
/.kiro/[0-9]*
/.kiro/**/*.transcript

# Unrelated nested project with its own git history (do not vacuum into this repo)
/src/icd-document-editor/

# Build output
build/
*/build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.venv-xpu/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store

# Keep placeholder dirs that are otherwise empty
!**/.gitkeep
